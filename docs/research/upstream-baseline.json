    "copy_update_and_construct_skip_validation": true,
    "defaults_are_not_validated_by_default": true,
    "ignore_input_vs_assignment": "input ignored; assignment rejected",
    "mapping_serialization_and_fields_set_differ": true,
    "typeadapter_typeddict_only_validates_at_boundary": true,
    "minimal_bridge_reads_and_pydantic_serialization": true,
    "minimal_bridge_fastapi_http_and_openapi": true
  },
  "scope": "Upstream observations and incomplete bridge only; no Pydandict implementation"
}
