{
  "python": "3.11.14",
  "versions": {
    "pydantic": "2.13.4",
    "fastapi": "0.141.1",
    "httpx": "0.28.1",
    "pyright": "1.1.411"
  },
  "checks": {
    "basemodel_iteration": {
      "pairs": [
        [
